#version 450
// Pinhole 3DGS projection. Matches spirula_core::project and the
// no-distortion path of shaders/primitive_3dgs.slang (eps 0.3, or 0.1
// when antialiased). std430, one workgroup-local index per splat.

layout(local_size_x = 64) in;

struct Camera {
    vec4 intrins;
    uvec4 geom;
    vec4 row0;
    vec4 row1;
    vec4 row2;
};

layout(set = 0, binding = 0) readonly buffer CameraBuf { Camera cam; };
layout(set = 0, binding = 1) readonly buffer MeanBuf { vec4 means[]; };
layout(set = 0, binding = 2) readonly buffer QuatBuf { vec4 quats[]; };
layout(set = 0, binding = 3) readonly buffer ScaleBuf { vec4 scales[]; };
layout(set = 0, binding = 4) readonly buffer OpacBuf { float opacs[]; };
layout(set = 0, binding = 5) writeonly buffer OutBuf { vec4 outs[]; };

const float ALPHA_THRESHOLD = 1.0 / 255.0;

vec3 rot_row0(float w, float x, float y, float z) {
    return vec3(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y - w * z), 2.0 * (x * z + w * y));
}
vec3 rot_row1(float w, float x, float y, float z) {
    return vec3(2.0 * (x * y + w * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z - w * x));
}
vec3 rot_row2(float w, float x, float y, float z) {
    return vec3(2.0 * (x * z - w * y), 2.0 * (y * z + w * x), 1.0 - 2.0 * (x * x + y * y));
}

vec3 mul_rows(vec3 r0, vec3 r1, vec3 r2, vec3 v) {
    return vec3(dot(r0, v), dot(r1, v), dot(r2, v));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= cam.geom.z) return;

    vec4 o0 = vec4(0.0);
    vec4 o1 = vec4(0.0);

    vec3 mean = means[i].xyz;
    vec3 pc = vec3(
        dot(cam.row0.xyz, mean) + cam.row0.w,
        dot(cam.row1.xyz, mean) + cam.row1.w,
        dot(cam.row2.xyz, mean) + cam.row2.w);
    if (!(pc.z > 0.0)) {
        outs[2u * i] = o0;
        outs[2u * i + 1u] = o1;
        return;
    }

    vec4 q = quats[i];
    float ql = length(q);
    if (!(ql > 0.0)) q = vec4(1.0, 0.0, 0.0, 0.0);
    else q /= ql;
    float w = q.x, x = q.y, y = q.z, z = q.w;
    vec3 rr0 = rot_row0(w, x, y, z);
    vec3 rr1 = rot_row1(w, x, y, z);
    vec3 rr2 = rot_row2(w, x, y, z);
    vec3 s = exp(scales[i].xyz);
    vec3 m0 = vec3(rr0.x * s.x, rr0.y * s.y, rr0.z * s.z);
    vec3 m1 = vec3(rr1.x * s.x, rr1.y * s.y, rr1.z * s.z);
    vec3 m2 = vec3(rr2.x * s.x, rr2.y * s.y, rr2.z * s.z);
    vec3 c0 = vec3(dot(m0, m0), dot(m0, m1), dot(m0, m2));
    vec3 c1 = vec3(dot(m1, m0), dot(m1, m1), dot(m1, m2));
    vec3 c2 = vec3(dot(m2, m0), dot(m2, m1), dot(m2, m2));

    vec3 vr0 = cam.row0.xyz;
    vec3 vr1 = cam.row1.xyz;
    vec3 vr2 = cam.row2.xyz;
    vec3 cw0 = mul_rows(c0, c1, c2, vr0);
    vec3 cw1 = mul_rows(c0, c1, c2, vr1);
    vec3 cw2 = mul_rows(c0, c1, c2, vr2);
    // cov_cam = R * cov * R^T, rows of R are vr*.
    float cc00 = dot(vr0, cw0);
    float cc01 = dot(vr0, cw1);
    float cc02 = dot(vr0, cw2);
    float cc11 = dot(vr1, cw1);
    float cc12 = dot(vr1, cw2);
    float cc22 = dot(vr2, cw2);

    float fx = cam.intrins.x, fy = cam.intrins.y, cx = cam.intrins.z, cy = cam.intrins.w;
    float rz = 1.0 / pc.z;
    float J00 = fx * rz;
    float J11 = fy * rz;
    float J02 = -fx * pc.x * rz * rz;
    float J12 = -fy * pc.y * rz * rz;
    float width = float(cam.geom.x);
    float height = float(cam.geom.y);
    float lim_x_pos = width + 0.3 * (0.5 * width);
    float lim_x_neg = 0.3 * (0.5 * width);
    float lim_y_pos = height + 0.3 * (0.5 * height);
    float lim_y_neg = 0.3 * (0.5 * height);
    float max_Jxz = -(-lim_x_neg - cx) * rz;
    float min_Jxz = -(lim_x_pos - cx) * rz;
    float max_Jyz = -(-lim_y_neg - cy) * rz;
    float min_Jyz = -(lim_y_pos - cy) * rz;
    J02 = clamp(J02, min_Jxz, max_Jxz);
    J12 = clamp(J12, min_Jyz, max_Jyz);

    // J * cov_cam * J^T. J rows are (J00, 0, J02) and (0, J11, J12).
    float jCv_x0 = J00 * cc00 + J02 * cc02;
    float jCv_y0 = J00 * cc01 + J02 * cc12;
    float jCv_z0 = J00 * cc02 + J02 * cc22;
    float jCv_x1 = J11 * cc01 + J12 * cc02;
    float jCv_y1 = J11 * cc11 + J12 * cc12;
    float jCv_z1 = J11 * cc12 + J12 * cc22;
    float a = J00 * jCv_x0 + J02 * jCv_z0;
    float b = J00 * jCv_x1 + J02 * jCv_z1;
    float c = J11 * jCv_y1 + J12 * jCv_z1;

    float det_orig = a * c - b * b;
    bool aa = (cam.geom.w & 1u) != 0u;
    float eps2d = aa ? 0.1 : 0.3;
    a += eps2d;
    c += eps2d;
    float det = a * c - b * b;
    float opacity = 1.0 / (1.0 + exp(-opacs[i]));
    if (!(det > 0.0)) {
        outs[2u * i] = o0;
        outs[2u * i + 1u] = o1;
        return;
    }
    if (aa) {
        float comp = sqrt(max(0.0, det_orig / det));
        opacity *= comp;
    }
    if (!(opacity >= ALPHA_THRESHOLD)) {
        outs[2u * i] = o0;
        outs[2u * i + 1u] = o1;
        return;
    }

    float inv_det = 1.0 / det;
    float c00 = c * inv_det;
    float c01 = -b * inv_det;
    float c11 = a * inv_det;
    float mx = fx * pc.x * rz + cx;
    float my = fy * pc.y * rz + cy;
    float extend = min(3.33, sqrt(2.0 * log(opacity / ALPHA_THRESHOLD)));
    float rx = extend * sqrt(max(a, 0.0));
    float ry = extend * sqrt(max(c, 0.0));
    if (mx + rx <= 0.0 || mx - rx >= width || my + ry <= 0.0 || my - ry >= height) {
        outs[2u * i] = o0;
        outs[2u * i + 1u] = o1;
        return;
    }

    outs[2u * i] = vec4(mx, my, length(pc), opacity);
    outs[2u * i + 1u] = vec4(c00, c01, c11, 1.0);
}
