      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"Workspace\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">Preview</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">Settings</button></div>",
      "css": ".ds-tabs{display:flex;flex-wrap:wrap;gap:6px;border-bottom:1px solid #263F55;}.ds-tab{font:16px \"Spirula UI\",\"Source Sans 3\",sans-serif;background:#1B242D;color:#E8EDF2;padding:5px 8px;border:0;border-radius:4px 4px 0 0;cursor:pointer;}.ds-tab[aria-selected=\"true\"]{background:#263F55;}.ds-tab:hover,.ds-tab:active{background:#2A3D50;}.ds-tab:focus-visible{outline:2px solid #8CC4F3;outline-offset:3px;}"
