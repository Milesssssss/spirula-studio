      "html": "<button class=\"ds-key\" title=\"Save (Ctrl+S)\"><span class=\"ds-key-label\">Save</span><span class=\"ds-key-hint\">Ctrl+S</span></button>",
      "css": ".ds-key{font:16px \"Spirula UI\",\"Source Sans 3\",sans-serif;display:inline-flex;align-items:center;justify-content:space-between;gap:6px;background:#293745;color:#E8EDF2;border:0;border-radius:4px;padding:5px 8px;cursor:pointer;}.ds-key-hint{color:rgba(255,255,255,.35294117647058826);}.ds-key:hover{background:#304253;}.ds-key:active{background:#34485B;}.ds-key:focus-visible{outline:2px solid #8CC4F3;outline-offset:3px;}"
    }
