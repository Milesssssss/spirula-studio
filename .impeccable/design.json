      "css": ".ds-actions{font:16px \"Spirula UI\",\"Source Sans 3\",sans-serif;display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;background:#171E26;color:#E8EDF2;border:1px solid #334352;border-radius:4px;padding:10px 12px;}.ds-actions-start{font:16px \"Spirula UI\",\"Source Sans 3\",sans-serif;background:#225B86;color:#E8EDF2;border:0;border-radius:4px;padding:5px 8px;cursor:pointer;}.ds-actions-start:hover{background:#2B6A99;}.ds-actions-start:active{background:#225075;}.ds-actions-start:focus-visible{outline:2px solid #8CC4F3;outline-offset:3px;}.ds-actions-status{color:#B0BFCC;}"
    },
    {
      "name": "Command Row",
      "kind": "custom",
      "refersTo": "command-row-primary",
      "description": "Explanatory title-and-description button. Native command_row measures wrapped text and retains a translated button ID.",
      "html": "<button class=\"ds-command\"><span class=\"ds-command-title\">Open a Dataset...</span><span class=\"ds-command-detail\">A folder containing an already-processed dataset: COLMAP (sparse/0), Nerfstudio (transforms.json), or Metashape exports. The format is detected automatically.</span></button>",
      "css": ".ds-command{font:16px \"Spirula UI\",\"Source Sans 3\",sans-serif;display:flex;flex-direction:column;gap:4px;width:100%;text-align:left;white-space:normal;background:#225B86;color:#E8EDF2;border:0;border-radius:4px;padding:10px 12px;cursor:pointer;}.ds-command-detail{color:#D7E8F7;}.ds-command:hover{background:#2B6A99;}.ds-command:active{background:#225075;}.ds-command:focus-visible{outline:2px solid #8CC4F3;outline-offset:3px;}"
